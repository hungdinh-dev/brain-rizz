# Cổng server lắng nghe (Fly.io/Render tự đặt PORT khi deploy)
PORT=2567

# development | production — production sẽ tắt /monitor và /playground
NODE_ENV=development

# Supabase (ADR 0011): xác thực tài khoản người chơi và ghi kết quả Kiểm tra não / trận party.
# Để trống thì server vẫn chạy, chỉ bỏ qua bước lưu (log một dòng lúc khởi động).
# Lấy ở Supabase Dashboard → Project Settings → API Keys. Khoá SECRET (sb_secret_… hoặc
# service_role kiểu cũ) bỏ qua RLS: chỉ đặt trên game server, KHÔNG BAO GIỜ đưa vào web.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
