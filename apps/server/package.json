{
  "name": "@brain-rizz/server",
  "version": "0.1.0",
  "private": true,
  "description": "Game server real-time (Colyseus): phòng chơi, đồng hồ, chấm điểm.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "loadtest": "tsx loadtest/party.ts --room party --numClients 8",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.36",
    "@colyseus/tools": "^0.18.9",
    "@supabase/supabase-js": "^2.118.0",
    "colyseus": "^0.18.9",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@brain-rizz/shared": "workspace:*",
    "@colyseus/loadtest": "^0.18.1",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/testing": "^0.18.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
